# Grok 注册机 - 环境变量模板
# 复制为 .env 并填入真实值
# 注意：真实进程环境变量优先于 .env

# Web 管理面（VPS 公网部署时必须设置 WEB_ADMIN_PASSWORD）
WEB_HOST=127.0.0.1
WEB_PORT=5000
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=

# OpenAI-CPA 邮件 Worker 通信密钥
EMAIL_WEBHOOK_SECRET=
# 本地模式建议 true；公网 VPS 仅用 Webhook 时可设 false
OPENAI_CPA_CLOUDMAIL_FALLBACK=true

# CloudMail 管理后台
CLOUDMAIL_URL=
CLOUDMAIL_ADMIN_EMAIL=
CLOUDMAIL_PASSWORD=

# grok2api App Key
GROK2API_APP_KEY=
