# 管理控制台 HTTP Basic Auth。请使用随机强密码，不要沿用邮箱或 Cloudflare 密钥。
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=replace-with-a-long-random-password

# Cloudflare 邮件 Worker 的 EMAIL_WEBHOOK_SECRET 必须与此一致。
EMAIL_WEBHOOK_SECRET=replace-with-another-long-random-secret
OPENAI_CPA_CLOUDMAIL_FALLBACK=false

TZ=Asia/Shanghai

# 可选：CloudMail 使用环境变量时填写；不用可留空。
CLOUDMAIL_URL=
CLOUDMAIL_ADMIN_EMAIL=
CLOUDMAIL_PASSWORD=

# 可选：grok2api 管理密钥。
GROK2API_APP_KEY=
